// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Keyword {
  id   Int    @id @default(autoincrement())
  shop String
  word String

  @@unique([shop, word])
}

model SpamEvent {
  id        Int      @id @default(autoincrement())
  shop      String
  isSpam    Boolean
  reason    String
  createdAt DateTime @default(now())

  @@index([shop, createdAt, isSpam])
  // The retention prune filters on createdAt alone, which is not a prefix of the
  // index above, so without this it full-scans the table every hour. The
  // 20260322172654 migration rebuilt this table and dropped the standalone
  // createdAt index that used to exist.
  @@index([createdAt])
}

model Setting {
  id    Int    @id @default(autoincrement())
  shop  String
  key   String
  value String

  @@unique([shop, key])
}

// The merchant's own contact details, captured from the Admin API on app open.
// Not part of Session: PrismaSessionStorage rewrites that whole row on every
// token exchange, so anything parked in Session.email is lost on the next app
// open. Refreshed on a TTL rather than every load, and deleted on uninstall
// alongside the rest of the shop's data.
model ShopContact {
  shop          String    @id
  shopName      String?
  ownerName     String?
  email         String?
  contactEmail  String?
  country       String?
  plan          String?
  devStore      Boolean?
  shopCreatedAt DateTime?
  updatedAt     DateTime  @updatedAt
}
